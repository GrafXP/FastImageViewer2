<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one place Win32, Direct3D and WIC bindings are generated (CsWin32, blittable, public),
       so that the other projects can pass these types to each other. Add names to NativeMethods.txt. -->
  <PropertyGroup>
    <RootNamespace>Fiv.Interop</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);CS1591;CS0649;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.360" PrivateAssets="all" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.DisableRuntimeMarshallingAttribute" />
  </ItemGroup>

</Project>
